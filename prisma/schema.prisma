generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  password         String
  userType         String
  name             String  @default("Juanito")
  surname          String  @default("Pérez")
  phoneNumber      String  @default("+56976212644")
  role             String   @default("admin")
  payment_status   String   @default("starter")
  last_payment     DateTime?
  
  // Security fields
  mfaEnabled       Boolean  @default(false)
  mfaSecret        String?
  mfaBackupCodes   String?
  accountLocked    Boolean  @default(false)
  lastLoginAt      DateTime?
  loginAttempts    Int      @default(0)
  securityNotifications Boolean @default(true)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  employee         Employee?
  restaurants      Restaurant[]  // Changed from restaurant to restaurants (one-to-many)
  restaurantUsers  RestaurantUser[]
  
  // AI Agent relations
  agentConversations  AgentConversation[]
  createdAgents       AiAgent[]
  
  // Notifications
  notifications       Notification[]
}

model TokenDenyList {
  id            Int      @id @default(autoincrement())
  token         String   @unique
  invalidatedAt DateTime @default(now())
}

model Employee {
  id           Int      @id @default(autoincrement())
  name         String
  surname      String   @default("Pérez")
  country      String
  location     String?
  position     String
  genre        String  @default("not declared")
  civilState   String  @default("single")
  aboutMe      String
  schedule     String
  region       String  @default("No hay")
  comuna       String  @default("No hay")
  available    String
  profileImageUrl String  @default("No photo")
  period       String  @default("No mencionado")
  birthDate    DateTime @default(dbgenerated("timestamp '1996-02-02 00:00:00'"))
  phoneNumber  String @default("+56912345678")
  yearsOfExperience String @default("No experience")

  skills       String[]
  userId       Int         @unique
  user         User        @relation(fields: [userId], references: [id])
  conversations Conversation[]
  talentPools     TalentPool[]
  favouriteJobs      FavouriteJob[]
  applications Application[]
  experiences  Experience[]
  educations   Education[]
  messagesSent  Message[] @relation("SenderEmployee")
  messagesReceived Message[] @relation("ReceiverEmployee")
  
  // AI Agent relations
  scheduledCalls      ScheduledCall[]
}

model Experience {
  id           Int      @id @default(autoincrement())
  companyName  String
  description  String
  startDate    DateTime
  endDate      DateTime
  role         String @default("No position")
  employeeId   Int
  employee     Employee @relation(fields: [employeeId], references: [id])
}

model Education {
  id           Int         @id @default(autoincrement())
  institution  String
  startDate    DateTime
  study        String      @default("")
  endDate      DateTime
  description  String
  employeeId   Int
  employee     Employee    @relation(fields: [employeeId], references: [id])
}

model Restaurant {
  id                   Int       @id @default(autoincrement())
  name                 String
  specialty            String
  format               String
  region               String   @default("No hay")
  comuna               String   @default("No hay")
  description          String   @default("No description to show")
  rut                  String   @default("No rut to show")
  legalName            String   @default("No legal name to show")
  numberOfRestaurants  Int
  profileImageUrl String   @default("No photo")
  profileCarouselUrls String[] @default([])
  workers              String
  weeklyAverageClients String
  benefits             String[]
  locations            Location[]
  jobOffers            JobOffer[]
  userId               Int       // Removed @unique constraint to allow multiple restaurants per user
  user                 User      @relation(fields: [userId], references: [id])
  restaurantUsers      RestaurantUser[]
  talentPools     TalentPool[]
  conversations        Conversation[]
  
  // AI Agent relations
  aiAgents            AiAgent[]
  scheduledCalls      ScheduledCall[]
}

model Location {
  id           Int        @id @default(autoincrement())
  address      String
  latitude Float @default(0)
  longitude Float @default(0)
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  jobOffers    JobOffer[]
}

model JobOffer {
  id                 Int              @id @default(autoincrement())
  position           String
  locationId         Int?
  location           Location?         @relation(fields: [locationId], references: [id])
  schedule           String
  period             String           @default("Sin información")
  contract           String
  salary             Int              @default(0)
  tips               Boolean          @default(true)
  functions          String           @default("No functions to show")
  requirements       String           @default("No requirements to show")
  vacancies          Int
  yearsOfExperience  Int
  description        String
  questions          Question[]
  restaurantId       Int
  restaurant         Restaurant       @relation(fields: [restaurantId], references: [id])
  applications       Application[]
  conversations      Conversation[]
  favouriteJobs      FavouriteJob[]
  createdAt  DateTime @default(now())
  restaurantUserId   Int?
  restaurantUser     RestaurantUser?  @relation(fields: [restaurantUserId], references: [id])
  deletedAt          DateTime?
}

model Question {
  id          Int     @id @default(autoincrement())
  question    String
  jobOfferId  Int
  jobOffer    JobOffer @relation(fields: [jobOfferId], references: [id])
  answers     Answer[]
}

model Application {
  id            Int       @id @default(autoincrement())
  jobPostId     Int
  employeeId    Int
  jobPost       JobOffer   @relation(fields: [jobPostId], references: [id])
  employee      Employee   @relation(fields: [employeeId], references: [id])
  answers       Answer[]
  deletedAt     DateTime?
}

model Answer {
  id            Int       @id @default(autoincrement())
  questionId    Int
  answer        String
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId Int
  question      Question @relation(fields: [questionId], references: [id])
}

model Conversation {
  id               Int            @id @default(autoincrement())
  messages         Message[]
  employeeId       Int
  restaurantUserId Int
  restaurantId     Int            // Direct reference to restaurant for cleaner filtering
  type             String         @default("none")
  jobOfferId       Int?
  jobOffer         JobOffer?      @relation(fields: [jobOfferId], references: [id])

  talentPoolId     Int?
  talentPool       TalentPool?    @relation(fields: [talentPoolId], references: [id])

  employee         Employee       @relation(fields: [employeeId], references: [id])
  restaurantUser   RestaurantUser @relation(fields: [restaurantUserId], references: [id])
  restaurant       Restaurant     @relation(fields: [restaurantId], references: [id])
  deletedAt        DateTime?
  
  // AI Agent relations
  agentConversations  AgentConversation[]
}

model Message {
  id                        Int              @id @default(autoincrement())
  text                      String
  conversationId            Int
  conversation              Conversation     @relation(fields: [conversationId], references: [id])

  senderEmployeeId          Int?
  senderEmployee            Employee?        @relation("SenderEmployee", fields: [senderEmployeeId], references: [id])

  senderRestaurantUserId    Int?
  senderRestaurantUser      RestaurantUser?  @relation("SenderRestaurantUser", fields: [senderRestaurantUserId], references: [id])

  receiverEmployeeId        Int?
  receiverEmployee          Employee?        @relation("ReceiverEmployee", fields: [receiverEmployeeId], references: [id])

  receiverRestaurantUserId  Int?
  receiverRestaurantUser    RestaurantUser?  @relation("ReceiverRestaurantUser", fields: [receiverRestaurantUserId], references: [id])

  createdAt                 DateTime         @default(now())
  
  // AI Agent relations
  agentMessages       AgentMessage[]
}

model RestaurantUser {
  id            Int            @id @default(autoincrement())
  userId        Int
  restaurantId  Int
  role          String         @default("staff")
  user          User           @relation(fields: [userId], references: [id])
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id])
  conversations Conversation[]
  addedTalent   TalentPool[]   @relation("AddedByUser")
  jobOffers     JobOffer[]
  messagesSent     Message[] @relation("SenderRestaurantUser")
  messagesReceived Message[] @relation("ReceiverRestaurantUser")
  
  // AI Agent relations
  scheduledCalls      ScheduledCall[]
}

model TalentPool {
  id             Int           @id @default(autoincrement())
  employeeId     Int
  restaurantId   Int
  addedByUserId  Int?
  status         String       @default("pendent")
  conversations      Conversation[]
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  employee       Employee     @relation(fields: [employeeId], references: [id])
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id])
  addedByUser    RestaurantUser? @relation("AddedByUser", fields: [addedByUserId], references: [id])
}

model FavouriteJob {
  id         Int       @id @default(autoincrement())
  employeeId Int
  jobOfferId  Int?
  createdAt  DateTime  @default(now())
  employee   Employee  @relation(fields: [employeeId], references: [id])
  jobOffer   JobOffer?     @relation(fields: [jobOfferId], references: [id])
}

model ContactSubmission {
  id         Int      @id @default(autoincrement())
  name       String?
  email      String?
  phone      String?
  subject    String?
  message    String?
  createdAt  DateTime @default(now())
}

// AI Agent System Models
model AiAgent {
  id                Int      @id @default(autoincrement())
  name              String
  description       String?
  avatar            String?  // URL to agent avatar image
  personality       String?  // JSON string with personality traits
  capabilities      String[] // Array of capabilities: ["schedule_calls", "answer_questions", "collect_info"]
  isActive          Boolean  @default(true)
  restaurantId      Int?     // If null, agent is global
  createdByUserId   Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  restaurant        Restaurant? @relation(fields: [restaurantId], references: [id])
  createdBy         User        @relation(fields: [createdByUserId], references: [id])
  conversations     AgentConversation[]
  scheduledCalls    ScheduledCall[]
  agentConfigs      AgentConfig[]
}

model AgentConversation {
  id                Int      @id @default(autoincrement())
  agentId           Int
  userId            Int      // User talking to the agent
  conversationId    Int      // Links to existing Conversation model
  context           String?  // JSON string with conversation context
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  agent             AiAgent      @relation(fields: [agentId], references: [id])
  user              User         @relation(fields: [userId], references: [id])
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  messages          AgentMessage[]
  
  @@unique([agentId, conversationId])
}

model AgentMessage {
  id                    Int      @id @default(autoincrement())
  agentConversationId   Int
  messageId             Int      // Links to existing Message model
  agentResponse         String?  // AI agent's response
  intent                String?  // Detected intent: "schedule_call", "question", "greeting"
  entities              String?  // JSON string with extracted entities
  confidence            Float?   // Confidence score of the response
  createdAt             DateTime @default(now())
  
  // Relations
  agentConversation     AgentConversation @relation(fields: [agentConversationId], references: [id])
  message               Message           @relation(fields: [messageId], references: [id])
}

model ScheduledCall {
  id                Int      @id @default(autoincrement())
  agentId           Int
  restaurantId      Int
  employeeId        Int?     // If scheduling with an employee
  restaurantUserId  Int?     // If scheduling with restaurant staff
  title             String
  description       String?
  scheduledDate     DateTime
  duration          Int      @default(30) // Duration in minutes
  status            String   @default("scheduled") // scheduled, completed, cancelled, rescheduled
  meetingLink       String?  // Zoom, Google Meet, etc.
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  agent             AiAgent        @relation(fields: [agentId], references: [id])
  restaurant        Restaurant     @relation(fields: [restaurantId], references: [id])
  employee          Employee?      @relation(fields: [employeeId], references: [id])
  restaurantUser    RestaurantUser? @relation(fields: [restaurantUserId], references: [id])
}

model AgentConfig {
  id                Int      @id @default(autoincrement())
  agentId           Int
  configKey         String   // e.g., "openai_model", "max_tokens", "temperature"
  configValue       String   // JSON string for complex values
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  agent             AiAgent  @relation(fields: [agentId], references: [id])
  
  @@unique([agentId, configKey])
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        String   // 'job_application', 'message', 'job_offer', 'system'
  title       String
  message     String
  isRead      Boolean  @default(false)
  data        String?  // JSON string with additional data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, isRead])
  @@index([userId, createdAt])
}





