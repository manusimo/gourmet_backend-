generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                 @id @default(autoincrement())
  password              String
  userType              String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  email                 String              @unique
  role                  String              @default("admin")
  name                  String              @default("Juanito")
  phoneNumber           String              @default("+56976212644")
  surname               String              @default("Pérez")
  last_payment          DateTime?
  payment_status        String              @default("starter")
  accountLocked         Boolean             @default(false)
  lastLoginAt           DateTime?
  loginAttempts         Int                 @default(0)
  mfaBackupCodes        String?
  mfaEnabled            Boolean             @default(false)
  mfaSecret             String?
  securityNotifications Boolean             @default(true)
  agentConversations    AgentConversation[]
  createdAgents         AiAgent[]
  employee              Employee?
  notifications         Notification[]
  restaurants           Restaurant[]
  restaurantUsers       RestaurantUser[]
}

model TokenDenyList {
  id            Int      @id @default(autoincrement())
  token         String   @unique
  invalidatedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model KnowledgeDocument {
  id           Int      @id @default(autoincrement())
  content      String
  embedding    String
  metadata     String
  type         String
  qualityScore Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("KnowledgeDocument")
}

model Employee {
  id                Int             @id @default(autoincrement())
  name              String
  country           String
  location          String?
  position          String
  aboutMe           String
  schedule          String
  available         String
  skills            String[]
  userId            Int             @unique
  birthDate         DateTime        @default(dbgenerated("'1996-02-02 00:00:00'::timestamp without time zone"))
  phoneNumber       String          @default("+56912345678")
  civilState        String          @default("single")
  genre             String          @default("not declared")
  yearsOfExperience String          @default("No experience")
  period            String          @default("No mencionado")
  profileImageUrl   String          @default("No photo")
  comuna            String          @default("No hay")
  region            String          @default("No hay")
  surname           String          @default("Pérez")
  applications      Application[]
  conversations     Conversation[]
  educations        Education[]
  user              User            @relation(fields: [userId], references: [id])
  experiences       Experience[]
  favouriteJobs     FavouriteJob[]
  hirings           Hiring[]
  messagesReceived  Message[]       @relation("ReceiverEmployee")
  messagesSent      Message[]       @relation("SenderEmployee")
  reviews           Review[]
  scheduledCalls    ScheduledCall[]
  talentPools       TalentPool[]
  
  // Timestamps
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Experience {
  id          Int      @id @default(autoincrement())
  companyName String
  description String
  startDate   DateTime
  endDate     DateTime
  employeeId  Int
  role        String   @default("No position")
  employee    Employee @relation(fields: [employeeId], references: [id])
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Education {
  id          Int      @id @default(autoincrement())
  institution String
  startDate   DateTime
  endDate     DateTime
  description String
  employeeId  Int
  study       String   @default("")
  employee    Employee @relation(fields: [employeeId], references: [id])
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Restaurant {
  id                   Int              @id @default(autoincrement())
  specialty            String
  format               String
  numberOfRestaurants  Int
  workers              String
  weeklyAverageClients String
  benefits             String[]
  name                 String
  userId               Int
  description          String           @default("No description to show")
  legalName            String           @default("No legal name to show")
  rut                  String           @default("No rut to show")
  profileImageUrl      String           @default("No photo")
  comuna               String           @default("No hay")
  region               String           @default("No hay")
  profileCarouselUrls  String[]         @default([])
  deletedAt            DateTime?
  aiAgents             AiAgent[]
  conversations        Conversation[]
  hirings              Hiring[]
  jobOffers            JobOffer[]
  locations            Location[]
  user                 User             @relation(fields: [userId], references: [id])
  restaurantUsers      RestaurantUser[]
  reviews              Review[]
  scheduledCalls       ScheduledCall[]
  talentPools          TalentPool[]
  
  // Timestamps
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model Location {
  id           Int        @id @default(autoincrement())
  address      String
  restaurantId Int
  latitude     Float      @default(0)
  longitude    Float      @default(0)
  jobOffers    JobOffer[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  
  // Timestamps
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model JobOffer {
  id                Int             @id @default(autoincrement())
  position          String
  schedule          String
  contract          String
  yearsOfExperience Int
  description       String
  restaurantId      Int
  vacancies         Int
  functions         String          @default("No functions to show")
  requirements      String          @default("No requirements to show")
  salary            Int             @default(0)
  tips              Boolean         @default(true)
  restaurantUserId  Int?
  period            String          @default("Sin información")
  locationId        Int?
  deletedAt         DateTime?
  endDate           DateTime?
  startDate         DateTime?
  
  // Timestamps
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  applications      Application[]
  conversations     Conversation[]
  favouriteJobs     FavouriteJob[]
  hirings           Hiring[]
  location          Location?       @relation(fields: [locationId], references: [id])
  restaurant        Restaurant      @relation(fields: [restaurantId], references: [id])
  restaurantUser    RestaurantUser? @relation(fields: [restaurantUserId], references: [id])
  questions         Question[]
}

model Question {
  id         Int      @id @default(autoincrement())
  jobOfferId Int
  question   String
  answers    Answer[]
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id])
  
  // Timestamps
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Application {
  id         Int       @id @default(autoincrement())
  jobPostId  Int
  employeeId Int
  deletedAt  DateTime?
  answers    Answer[]
  employee   Employee  @relation(fields: [employeeId], references: [id])
  jobPost    JobOffer  @relation(fields: [jobPostId], references: [id])
  
  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Answer {
  id            Int         @id @default(autoincrement())
  questionId    Int
  answer        String
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id])
  question      Question    @relation(fields: [questionId], references: [id])
  
  // Timestamps
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Conversation {
  id                 Int                 @id @default(autoincrement())
  employeeId         Int
  restaurantUserId   Int
  jobOfferId         Int?
  type               String              @default("none")
  talentPoolId       Int?
  deletedAt          DateTime?
  restaurantId       Int
  agentConversations AgentConversation[]
  employee           Employee            @relation(fields: [employeeId], references: [id])
  jobOffer           JobOffer?           @relation(fields: [jobOfferId], references: [id])
  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id])
  restaurantUser     RestaurantUser      @relation(fields: [restaurantUserId], references: [id])
  talentPool         TalentPool?         @relation(fields: [talentPoolId], references: [id])
  hiring             Hiring?
  messages           Message[]
  
  // Timestamps
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Message {
  id                       Int             @id @default(autoincrement())
  text                     String
  conversationId           Int
  receiverEmployeeId       Int?
  receiverRestaurantUserId Int?
  senderEmployeeId         Int?
  senderRestaurantUserId   Int?
  agentMessages            AgentMessage[]
  conversation             Conversation    @relation(fields: [conversationId], references: [id])
  receiverEmployee         Employee?       @relation("ReceiverEmployee", fields: [receiverEmployeeId], references: [id])
  receiverRestaurantUser   RestaurantUser? @relation("ReceiverRestaurantUser", fields: [receiverRestaurantUserId], references: [id])
  senderEmployee           Employee?       @relation("SenderEmployee", fields: [senderEmployeeId], references: [id])
  senderRestaurantUser     RestaurantUser? @relation("SenderRestaurantUser", fields: [senderRestaurantUserId], references: [id])
  
  // Timestamps
  createdAt                DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
}

model RestaurantUser {
  id               Int             @id @default(autoincrement())
  userId           Int
  restaurantId     Int
  role             String          @default("staff")
  conversations    Conversation[]
  jobOffers        JobOffer[]
  messagesReceived Message[]       @relation("ReceiverRestaurantUser")
  messagesSent     Message[]       @relation("SenderRestaurantUser")
  restaurant       Restaurant      @relation(fields: [restaurantId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  scheduledCalls   ScheduledCall[]
  addedTalent      TalentPool[]    @relation("AddedByUser")
  
  // Timestamps
  createdAt        DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model TalentPool {
  id            Int             @id @default(autoincrement())
  employeeId    Int
  restaurantId  Int
  addedByUserId Int?
  status        String          @default("pendent")
  deletedAt     DateTime?
  conversations Conversation[]
  addedByUser   RestaurantUser? @relation("AddedByUser", fields: [addedByUserId], references: [id])
  employee      Employee        @relation(fields: [employeeId], references: [id])
  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id])
  
  // Timestamps
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model FavouriteJob {
  id         Int       @id @default(autoincrement())
  employeeId Int
  jobOfferId Int?
  employee   Employee  @relation(fields: [employeeId], references: [id])
  jobOffer   JobOffer? @relation(fields: [jobOfferId], references: [id])
  
  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String?
  phone     String?
  subject   String?
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiAgent {
  id              Int                 @id @default(autoincrement())
  name            String
  description     String?
  avatar          String?
  personality     String?
  capabilities    String[]
  isActive        Boolean             @default(true)
  restaurantId    Int?
  createdByUserId Int
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  agentConfigs    AgentConfig[]
  conversations   AgentConversation[]
  createdBy       User                @relation(fields: [createdByUserId], references: [id])
  restaurant      Restaurant?         @relation(fields: [restaurantId], references: [id])
  scheduledCalls  ScheduledCall[]
}

model AgentConversation {
  id             Int            @id @default(autoincrement())
  agentId        Int
  userId         Int
  conversationId Int
  context        String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  agent          AiAgent        @relation(fields: [agentId], references: [id])
  conversation   Conversation   @relation(fields: [conversationId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  messages       AgentMessage[]

  @@unique([agentId, conversationId])
}

model AgentMessage {
  id                  Int               @id @default(autoincrement())
  agentConversationId Int
  messageId           Int
  agentResponse       String?
  intent              String?
  entities            String?
  confidence          Float?
  agentConversation   AgentConversation @relation(fields: [agentConversationId], references: [id])
  message             Message           @relation(fields: [messageId], references: [id])
  
  // Timestamps
  createdAt           DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model ScheduledCall {
  id               Int             @id @default(autoincrement())
  agentId          Int
  restaurantId     Int
  employeeId       Int?
  restaurantUserId Int?
  title            String
  description      String?
  scheduledDate    DateTime
  duration         Int             @default(30)
  status           String          @default("scheduled")
  meetingLink      String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  agent            AiAgent         @relation(fields: [agentId], references: [id])
  employee         Employee?       @relation(fields: [employeeId], references: [id])
  restaurant       Restaurant      @relation(fields: [restaurantId], references: [id])
  restaurantUser   RestaurantUser? @relation(fields: [restaurantUserId], references: [id])
}

model AgentConfig {
  id          Int      @id @default(autoincrement())
  agentId     Int
  configKey   String
  configValue String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agent       AiAgent  @relation(fields: [agentId], references: [id])

  @@unique([agentId, configKey])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Hiring {
  id                  Int           @id @default(autoincrement())
  employeeId          Int
  restaurantId        Int
  jobOfferId          Int?
  conversationId      Int?          @unique
  offerDate           DateTime      @default(now())
  acceptanceDate      DateTime?
  offerExpirationDate DateTime?
  status              String        @default("offered")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  endMessageSent      Boolean       @default(false)
  startMessageSent    Boolean       @default(false)
  conversation        Conversation? @relation(fields: [conversationId], references: [id])
  employee            Employee      @relation(fields: [employeeId], references: [id])
  jobOffer            JobOffer?     @relation(fields: [jobOfferId], references: [id])
  restaurant          Restaurant    @relation(fields: [restaurantId], references: [id])
  reviews             Review[]

  @@index([employeeId, status])
  @@index([restaurantId, status])
  @@index([offerExpirationDate])
}

model Review {
  id           Int        @id @default(autoincrement())
  hiringId     Int
  employeeId   Int
  restaurantId Int
  reviewType   String
  rating       Int
  comment      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  employee     Employee   @relation(fields: [employeeId], references: [id])
  hiring       Hiring     @relation(fields: [hiringId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([employeeId])
  @@index([restaurantId])
  @@index([hiringId])
}
