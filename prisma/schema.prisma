generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  password         String
  userType         String
  name             String  @default("Juanito")
  surname          String  @default("Pérez")
  phoneNumber      String  @default("+56976212644")
  role             String   @default("admin")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  employee         Employee?
  restaurant       Restaurant?
  restaurantUsers  RestaurantUser[] 
}

model TokenDenyList {
  id            Int      @id @default(autoincrement())
  token         String   @unique
  invalidatedAt DateTime @default(now())
}

model Employee {
  id           Int      @id @default(autoincrement())
  name         String
  surname      String   @default("Pérez")
  country      String
  location     String?
  position     String
  genre        String  @default("not declared")
  civilState   String  @default("single")
  aboutMe      String
  schedule     String
  region       String  @default("No hay")
  comuna       String  @default("No hay")
  available    String
  profileImageUrl String  @default("No photo")
  period       String  @default("No mencionado")
  birthDate    DateTime @default(dbgenerated("timestamp '1996-02-02 00:00:00'"))
  phoneNumber  String @default("+56912345678")
  yearsOfExperience String @default("No experience")

  skills       String[]    
  userId       Int         @unique
  user         User        @relation(fields: [userId], references: [id])
  conversations Conversation[]
  talentPools     TalentPool[]
  favouriteJobs      FavouriteJob[]
  applications Application[]
  experiences  Experience[]
  educations   Education[]
  messagesSent  Message[] @relation("SenderEmployee")
  messagesReceived Message[] @relation("ReceiverEmployee")
}

model Experience {
  id           Int      @id @default(autoincrement())
  companyName  String
  description  String
  startDate    DateTime
  endDate      DateTime
  role         String @default("No position")
  employeeId   Int
  employee     Employee @relation(fields: [employeeId], references: [id])
}

model Education {
  id           Int         @id @default(autoincrement())
  institution  String
  startDate    DateTime
  study        String      @default("")
  endDate      DateTime
  description  String
  employeeId   Int
  employee     Employee    @relation(fields: [employeeId], references: [id])
}

model Restaurant {
  id                   Int       @id @default(autoincrement())
  name                 String 
  specialty            String
  format               String
  region               String   @default("No hay") 
  comuna               String   @default("No hay")
  description          String   @default("No description to show")
  rut                  String   @default("No rut to show")
  legalName            String   @default("No legal name to show")
  numberOfRestaurants  Int
  profileImageUrl String   @default("No photo")
  profileCarouselUrls String[] @default([])
  workers              String
  weeklyAverageClients String
  benefits             String[]
  locations            Location[]
  jobOffers            JobOffer[]
  userId               Int       @unique
  user                 User      @relation(fields: [userId], references: [id])
  restaurantUsers      RestaurantUser[] 
  talentPools     TalentPool[]
}

model Location {
  id           Int        @id @default(autoincrement())
  address      String
  latitude Float @default(0)
  longitude Float @default(0)
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  jobOffers    JobOffer[] 
}

model JobOffer {
  id                 Int              @id @default(autoincrement())
  position           String
  locationId         Int?             
  location           Location?         @relation(fields: [locationId], references: [id])
  schedule           String
  period             String           @default("Sin información")
  contract           String
  salary             Int              @default(0)
  tips               Boolean          @default(true)
  functions          String           @default("No functions to show")
  requirements       String           @default("No requirements to show")
  vacancies          Int
  yearsOfExperience  Int
  description        String
  questions          Question[]
  restaurantId       Int
  restaurant         Restaurant       @relation(fields: [restaurantId], references: [id])
  applications       Application[]
  conversations      Conversation[]
  favouriteJobs      FavouriteJob[]
  createdAt  DateTime @default(now())
  restaurantUserId   Int?
  restaurantUser     RestaurantUser?  @relation(fields: [restaurantUserId], references: [id])
}

model Question {
  id          Int     @id @default(autoincrement())
  question    String  
  jobOfferId  Int    
  jobOffer    JobOffer @relation(fields: [jobOfferId], references: [id])
  answers     Answer[]
}

model Application {
  id            Int       @id @default(autoincrement())
  jobPostId     Int
  employeeId    Int
  jobPost       JobOffer   @relation(fields: [jobPostId], references: [id])
  employee      Employee   @relation(fields: [employeeId], references: [id])
  answers       Answer[]
}

model Answer {
  id            Int       @id @default(autoincrement())
  questionId    Int
  answer        String
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId Int
  question      Question @relation(fields: [questionId], references: [id])
}

model Conversation {
  id               Int            @id @default(autoincrement())
  messages         Message[]
  employeeId       Int
  restaurantUserId Int 
  type             String         @default("none")
  jobOfferId       Int?
  jobOffer         JobOffer?      @relation(fields: [jobOfferId], references: [id])
  
  talentPoolId     Int?
  talentPool       TalentPool?    @relation(fields: [talentPoolId], references: [id])

  employee         Employee       @relation(fields: [employeeId], references: [id])
  restaurantUser   RestaurantUser @relation(fields: [restaurantUserId], references: [id])
}

model Message {
  id                        Int              @id @default(autoincrement())
  text                      String
  conversationId            Int
  conversation              Conversation     @relation(fields: [conversationId], references: [id])
  
  senderEmployeeId          Int?
  senderEmployee            Employee?        @relation("SenderEmployee", fields: [senderEmployeeId], references: [id])

  senderRestaurantUserId    Int?
  senderRestaurantUser      RestaurantUser?  @relation("SenderRestaurantUser", fields: [senderRestaurantUserId], references: [id])

  receiverEmployeeId        Int?
  receiverEmployee          Employee?        @relation("ReceiverEmployee", fields: [receiverEmployeeId], references: [id])

  receiverRestaurantUserId  Int?
  receiverRestaurantUser    RestaurantUser?  @relation("ReceiverRestaurantUser", fields: [receiverRestaurantUserId], references: [id])

  createdAt                 DateTime         @default(now())
}

model RestaurantUser {
  id            Int            @id @default(autoincrement())
  userId        Int
  restaurantId  Int
  role          String         @default("staff")
  user          User           @relation(fields: [userId], references: [id])
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id])
  conversations Conversation[]
  addedTalent   TalentPool[]   @relation("AddedByUser") 
  jobOffers     JobOffer[]
  messagesSent     Message[] @relation("SenderRestaurantUser")
  messagesReceived Message[] @relation("ReceiverRestaurantUser")
}

model TalentPool {
  id             Int           @id @default(autoincrement())
  employeeId     Int
  restaurantId   Int
  addedByUserId  Int?
  status         String       @default("pendent")
  conversations      Conversation[]
  createdAt      DateTime     @default(now())
  employee       Employee     @relation(fields: [employeeId], references: [id])
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id])
  addedByUser    RestaurantUser? @relation("AddedByUser", fields: [addedByUserId], references: [id]) 
}

model FavouriteJob {
  id         Int       @id @default(autoincrement())
  employeeId Int
  jobOfferId  Int?
  createdAt  DateTime  @default(now())
  employee   Employee  @relation(fields: [employeeId], references: [id])
  jobOffer   JobOffer?     @relation(fields: [jobOfferId], references: [id])
}









